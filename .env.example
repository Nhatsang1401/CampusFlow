
# ==========================================
# CAMPUSFLOW - ENVIRONMENT CONFIGURATION
# ==========================================

APP_NAME=CampusFlow
APP_VERSION=0.1.0
APP_ENV=development

# Django
SECRET_KEY=replace-this-with-a-generated-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Django settings
DJANGO_SETTINGS_MODULE=config.settings.development

# Database
DB_ENGINE=sqlite
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Timezone
TIME_ZONE=Asia/Ho_Chi_Minh

# Logging
LOG_LEVEL=INFO

# Security
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
